# Añade este bloque a tu Caddyfile existente en el VPS
# Si ya tienes un bloque para byalboroto.duckdns.org, añade solo los `handle_path` dentro de él

byalboroto.duckdns.org {

  # Redirige /freiduria → /freiduria/ si acceden sin barra final
  redir /freiduria /freiduria/ 301

  # Strip /freiduria y proxy al contenedor Express (puerto 3001)
  # handle_path elimina el prefijo antes de pasar la petición al backend
  # El backend recibe /api/..., /socket.io, / — sin el prefijo /freiduria
  handle_path /freiduria/* {
    reverse_proxy localhost:3001
  }

  # Si tienes otras apps en este dominio, déjalas fuera de este bloque
}
